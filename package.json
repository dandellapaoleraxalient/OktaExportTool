{
  "name": "okta-export",
  "version": "1.0.0",
  "description": "Node.js application to export Okta data and generate reports",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "setup": "node setup.js",
    "prod": "node src/app.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop okta-export",
    "pm2:restart": "pm2 restart okta-export",
    "pm2:logs": "pm2 logs okta-export",
    "health": "curl -f http://localhost:4000/api/health || exit 1"
  },
  "dependencies": {
    "@okta/okta-sdk-nodejs": "^7.0.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "json2csv": "^5.0.7",
    "exceljs": "^4.4.0",
    "moment": "^2.29.4",
    "helmet": "^7.1.0",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0"
  },
  "keywords": [
    "okta",
    "export",
    "api",
    "report",
    "nodejs"
  ],
  "author": "",
  "license": "ISC"
}
